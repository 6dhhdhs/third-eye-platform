# 复制为 backend/.env 后按本机情况修改；.env 已被 git 忽略

# ---- 服务 ----
PORT=3000
NODE_ENV=development
# 若部署在 Nginx 等反向代理后面，设为 true 以正确获取客户端 IP
TRUST_PROXY=false

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=改成你的root密码
DB_NAME=third_eye
DB_CONNECTION_LIMIT=10

# ---- JWT ----
# 至少 32 个字符。生成方式：
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为至少32位的随机字符串
JWT_ISSUER=third-eye-api
JWT_AUDIENCE=third-eye-web
# 普通登录有效期 / 勾选「记住我」后的有效期
JWT_EXPIRES_IN=2h
JWT_REMEMBER_EXPIRES_IN=7d

# ---- 密码哈希 ----
# bcrypt 计算轮数，10 适合开发；生产可调到 12（更安全但更慢）
BCRYPT_ROUNDS=10

# ---- CORS ----
# 前端静态原型默认跑在 4173 端口
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# ---- 限流（毫秒 / 次数）----
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5
