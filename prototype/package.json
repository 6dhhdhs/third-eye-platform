{
  "name": "third-eye-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "第三只眼 —— 师范生智能学习与教学能力训练平台 · 高保真静态原型",
  "scripts": {
    "build:css": "node node_modules/tailwindcss/lib/cli.js -c tailwind.config.js -i ./src/styles/input.css -o ./assets/css/app.css --minify",
    "watch:css": "node node_modules/tailwindcss/lib/cli.js -c tailwind.config.js -i ./src/styles/input.css -o ./assets/css/app.css --watch",
    "serve": "python -m http.server 4173",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"index.html\" \"pages/**/*.html\" \"assets/js/**/*.js\" \"archive/originals/**/*.html\" \"*.js\""
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "material-symbols": "^0.20.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17"
  }
}
